<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Geronex" parent="Theme.Material3.Light.NoActionBar">
        <!-- Colores de GERONEX para dialogos, selectores de fecha y casillas -->
        <item name="colorPrimary">@color/azul_marino</item>
        <item name="colorSecondary">@color/naranja</item>
        <item name="colorAccent">@color/naranja</item>
        <item name="android:statusBarColor">@color/azul_marino</item>
    </style>

    <style name="Theme.Geronex" parent="Base.Theme.Geronex" />

    <!-- Titulo de seccion dentro de una ficha (comprobante) -->
    <style name="TituloSeccion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/azul_marino</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
</resources>
