<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema"
    android:orientation="vertical">

    <include layout="@layout/encabezado"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/ivDestino"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:contentDescription="Destino"
                android:scaleType="centerCrop"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Cuéntanos tu viaje y un agente te enviará una cotización."
                android:textColor="@color/gris"
                android:textSize="14sp"/>

            <!-- Destino -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Destino"
                android:textColor="@color/azul_grisaceo"
                android:textSize="13sp"
                android:textStyle="bold"/>
            <AutoCompleteTextView
                android:id="@+id/etDestino"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:completionThreshold="1"
                android:hint="Ej. Cancún"
                android:inputType="textCapWords"
                android:maxLength="100"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/azul_marino"
                android:textColorHint="#808080"/>
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/contSugerencias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>

            <!-- Fechas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fecha de ida"
                        android:textColor="@color/azul_grisaceo"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/btnIda"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:text="📅  Elegir"
                        android:textColor="@color/azul_marino"
                        android:textSize="15sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fecha de regreso"
                        android:textColor="@color/azul_grisaceo"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/btnRegreso"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:text="📅  Elegir"
                        android:textColor="@color/azul_marino"
                        android:textSize="15sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Personas -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Personas (1 a 50)"
                android:textColor="@color/azul_grisaceo"
                android:textSize="13sp"
                android:textStyle="bold"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnMenos"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:contentDescription="Una persona menos"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/azul_marino"
                    android:textSize="24sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvPersonas"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/azul_marino"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/btnMas"
                    android:layout_width="52dp"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:contentDescription="Una persona más"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/azul_marino"
                    android:textSize="24sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Presupuesto -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Presupuesto en pesos (opcional)"
                android:textColor="@color/azul_grisaceo"
                android:textSize="13sp"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/etPresupuesto"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="Ej. 30000"
                android:inputType="numberDecimal"
                android:maxLength="11"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/azul_marino"
                android:textColorHint="#808080"/>

            <!-- Necesidades -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="¿Qué necesitas? (opcional)"
                android:textColor="@color/azul_grisaceo"
                android:textSize="13sp"
                android:textStyle="bold"/>
            <EditText
                android:id="@+id/etNecesidades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="Ej. Hotel frente al mar, viajamos con niños, queremos un tour"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="500"
                android:minLines="3"
                android:padding="14dp"
                android:textColor="@color/azul_marino"
                android:textColorHint="#808080"/>
            <TextView
                android:id="@+id/tvContador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:text="0 / 500"
                android:textColor="@color/gris"
                android:textSize="12sp"/>

            <!-- Resumen -->
            <TextView
                android:id="@+id/tvResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:text="Elige tus fechas para ver la duración del viaje."
                android:textColor="@color/azul_grisaceo"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:padding="12dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/btnEnviar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_boton_naranja"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingBottom="4dp"
                android:text="Enviar solicitud"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
